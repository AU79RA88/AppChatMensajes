<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp"/>


    <ProgressBar
        android:id="@+id/chatProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"
        android:indeterminateTint="#2196F3"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="#FAFAFA"
        android:elevation="4dp">


        <EditText
            android:id="@+id/messageEditText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="@drawable/bg_edittext_round"
            android:padding="12dp"
            android:textColor="#000000"
            android:textSize="16sp"
            android:hint="Escribe un mensaje..."
            android:fontFamily="@font/roboto_regular"
            android:inputType="textMultiLine"
            android:maxLines="4"/>


        <ImageView
            android:id="@+id/btnSendImage"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_image"
            android:background="@drawable/bg_icon_round"
            android:contentDescription="Enviar imagen" />


        <ImageView
            android:id="@+id/sendButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="6dp"
            android:padding="8dp"
            android:src="@drawable/ic_send"
            android:background="@drawable/bg_icon_round_blue"
            android:contentDescription="Enviar mensaje" />

    </LinearLayout>

</LinearLayout>
